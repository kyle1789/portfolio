<% github_url = ENV.fetch("PORTFOLIO_GITHUB_URL", "https://github.com/kyle1789") %><% linkedin_url = ENV.fetch("PORTFOLIO_LINKEDIN_URL", "https://www.linkedin.com/in/kyle1789/") %><% resume_url = ENV.fetch("PORTFOLIO_RESUME_URL", "/kyle-teixeira-trindade-resume.pdf") %><% email = ENV.fetch("PORTFOLIO_EMAIL", "kyle.trindade2@gmail.com") %><% phone = ENV.fetch("PORTFOLIO_PHONE", "+5531988437435") %>
<header class="fixed inset-x-0 top-0 z-50 border-b border-white/5 bg-[#0b0d0e]/90 backdrop-blur"><nav class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-6"><a href="#top" class="font-bold tracking-tight text-white">KTT<span class="text-emerald-400">.</span></a><div class="hidden gap-7 text-sm text-stone-400 md:flex"><a href="#experience"><%= t("portfolio.nav.experience", default: "Experience") %></a><a href="#work"><%= t("portfolio.nav.work", default: "Work") %></a><a href="#expertise"><%= t("portfolio.nav.expertise", default: "Expertise") %></a><a href="#contact"><%= t("portfolio.nav.contact", default: "Contact") %></a></div><div class="flex items-center gap-3"><div class="flex rounded-full border border-white/15 p-1 text-xs"><%= link_to "PT", root_path(locale: "pt-BR"), class: "rounded-full px-2.5 py-1 #{'bg-white text-stone-950' if I18n.locale == :'pt-BR'}" %><%= link_to "EN", root_path(locale: "en"), class: "rounded-full px-2.5 py-1 #{'bg-white text-stone-950' if I18n.locale == :en}" %></div><a href="mailto:<%= email %>" class="hidden pill-link sm:block"><%= t("portfolio.nav.get_in_touch", default: "Get in touch") %></a></div></nav></header>
<main id="top">
<section class="mx-auto grid min-h-screen max-w-7xl content-center px-6 pb-20 pt-28"><p class="mb-7 font-mono text-sm uppercase tracking-[.25em] text-emerald-400"><%= t("portfolio.hero.location", default: "Brazil · Remote") %></p><h1 class="max-w-5xl text-6xl font-semibold leading-[.95] tracking-[-.055em] text-white sm:text-7xl lg:text-[7rem]">Kyle Teixeira<br>Trindade</h1><div class="mt-10 grid gap-8 border-t border-white/10 pt-8 lg:grid-cols-2"><div><p class="text-xl font-medium text-white"><%= t("portfolio.hero.role", default: "Software Engineer") %></p><p class="mt-2 text-stone-400"><%= t("portfolio.hero.focus", default: "Ruby on Rails · B2B Systems · SaaS · Integrations") %></p></div><div><p class="max-w-xl text-xl leading-relaxed text-stone-300"><%= t("portfolio.hero.intro", default: "I build business-oriented web applications and translate real operational processes into reliable software.") %></p><div class="mt-8 flex flex-wrap gap-3"><a href="#work" class="rounded-full bg-emerald-400 px-5 py-2.5 font-medium text-stone-950"><%= t("portfolio.hero.view_work", default: "View work") %></a><a href="<%= github_url %>" class="pill-link">GitHub</a><a href="<%= linkedin_url %>" class="pill-link">LinkedIn</a><a href="<%= resume_url %>" class="pill-link"><%= t("portfolio.hero.resume", default: "Resume") %></a></div></div></div></section>
<section class="section-grid border-y border-white/10 bg-white/[.02]"><p class="section-label"><%= t("portfolio.about.label", default: "01 / About") %></p><div><h2 class="section-title"><%= t("portfolio.about.title", default: "Software built around how business works.") %></h2><p class="body-copy mt-8"><%= t("portfolio.about.first", default: "I'm a software engineer focused primarily on Ruby on Rails and backend-heavy business applications. My experience includes software for imports, shipments, financial processes, negotiations, supplier management and document processing.") %></p><p class="body-copy mt-4"><%= t("portfolio.about.second", default: "I enjoy understanding a process—its constraints, rules and edge cases—and translating it into maintainable software.") %></p></div></section>
<section id="experience" class="mx-auto max-w-7xl px-6 py-28"><p class="section-label"><%= t("portfolio.experience.label", default: "02 / Professional experience") %></p><% @experiences.each do |experience| %><article class="mt-12 overflow-hidden rounded-3xl border border-white/10 bg-[#111415]"><div class="grid gap-8 p-7 sm:p-10 lg:grid-cols-[1fr_1fr]"><div><span class="eyebrow"><%= t("portfolio.experience.private", default: "Featured professional work · Private codebase") %></span><h2 class="mt-5 text-4xl font-semibold tracking-tight text-white sm:text-5xl"><%= localized_record(experience, :title) %></h2><p class="mt-3 text-lg text-emerald-300"><%= localized_record(experience, :subtitle) %></p></div><div><p class="text-lg leading-8 text-stone-300"><%= localized_record(experience, :short_description) %></p><div class="mt-6 flex flex-wrap gap-2"><% experience.technology_list.each do |technology| %><span class="tech"><%= technology %></span><% end %></div></div></div><div class="border-y border-white/10"><%= render "screenshots", record: experience %></div><div class="case-copy p-7 sm:p-10 lg:columns-2 lg:gap-14"><%= simple_format(localized_record(experience, :description)) %></div></article><% end %></section>
<section id="work" class="border-y border-white/10 bg-white/[.02]"><div class="mx-auto max-w-7xl px-6 py-28"><p class="section-label"><%= t("portfolio.work.label", default: "03 / Featured work") %></p><div class="mt-12 space-y-10"><% @projects.each_with_index do |project, index| %><article class="overflow-hidden rounded-3xl border border-white/10 bg-[#0d1011]"><div class="grid gap-8 p-7 sm:p-10 lg:grid-cols-[.8fr_1.2fr]"><div><div class="font-mono text-xs text-stone-500">0<%= index + 1 %></div><h3 class="mt-6 text-3xl font-semibold tracking-tight text-white sm:text-4xl"><%= localized_record(project, :name) %></h3><p class="mt-2 text-emerald-300"><%= localized_record(project, :short_description) %></p></div><div><div class="case-copy"><%= simple_format(localized_summary(project)) %></div><div class="mt-6 flex flex-wrap gap-2"><% project.technology_list.each do |technology| %><span class="tech"><%= technology %></span><% end %></div></div></div><div class="border-y border-white/10"><%= render "screenshots", record: project %><% unless project.screenshots.attached? %><div class="flex min-h-72 w-full items-center justify-center bg-[#15191a] p-8"><p class="whitespace-pre-line text-center font-mono text-xs uppercase tracking-widest text-stone-500"><%= t("portfolio.work.screenshots", default: "Sanitized screenshots\navailable on request") %></p></div><% end %></div><details class="group"><summary class="cursor-pointer list-none px-7 py-5 font-mono text-xs uppercase tracking-widest text-stone-400 transition hover:text-emerald-300 sm:px-10"><%= t("portfolio.work.details", default: "View engineering details") %> <span class="ml-2 inline-block transition group-open:rotate-45">+</span></summary><div class="case-copy px-7 pb-8 sm:px-10 lg:columns-2 lg:gap-14"><%= simple_format(localized_record(project, :description)) %></div></details></article><% end %></div></div></section>
<section id="expertise" class="section-grid"><p class="section-label"><%= t("portfolio.expertise.label", default: "04 / Technical expertise") %></p><div><h2 class="section-title"><%= t("portfolio.expertise.title", default: "Backend depth for operational software.") %></h2><div class="mt-12 grid gap-px overflow-hidden rounded-2xl border border-white/10 bg-white/10 sm:grid-cols-2"><% %w[rails data saas integrations security documents].each do |area| %><div class="bg-[#0b0d0e] p-7"><h3 class="font-medium text-white"><%= t("portfolio.expertise.#{area}_title", default: {"rails"=>"Rails engineering", "data"=>"Data & processing", "saas"=>"SaaS architecture", "integrations"=>"Integrations", "security"=>"Application security", "documents"=>"Document automation"}[area]) %></h3><p class="mt-2 leading-7 text-stone-400"><%= t("portfolio.expertise.#{area}_text", default: {"rails"=>"Ruby, Rails, Active Record, REST, domain modeling", "data"=>"PostgreSQL, Sidekiq, Redis, background workflows", "saas"=>"Multi-tenancy, Pundit, roles, company-scoped resources", "integrations"=>"GraphQL, Monday.com API, external data normalization", "security"=>"Rack::Attack, CSP, audit trails, IDOR mitigation", "documents"=>"OCR, regex, keyword extraction, ClamAV scanning"}[area]) %></p></div><% end %></div></div></section>
<section class="section-grid border-y border-white/10 bg-white/[.02]"><p class="section-label"><%= t("portfolio.education.label", default: "05 / Education") %></p><div><h2 class="text-4xl font-semibold tracking-tight text-white"><%= t("portfolio.education.degree", default: "Software Engineering") %></h2><p class="mt-3 text-stone-400"><%= t("portfolio.education.status", default: "Completed degree") %></p></div></section>
<section id="resume" class="border-b border-white/10 bg-white/[.02]"><div class="mx-auto max-w-7xl px-6 py-28"><div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-end"><div><p class="section-label"><%= t("portfolio.resume.label", default: "06 / Resume") %></p><h2 class="mt-6 text-4xl font-semibold tracking-[-.04em] text-white sm:text-6xl"><%= t("portfolio.resume.title", default: "Experience in detail.") %></h2><p class="mt-4 max-w-2xl text-lg leading-8 text-stone-400"><%= t("portfolio.resume.description", default: "View my complete resume or open the PDF in a new tab.") %></p></div><div class="flex flex-wrap gap-3"><%= link_to t("portfolio.resume.open", default: "Open PDF ↗"), resume_url, target: "_blank", rel: "noopener", class: "pill-link" %><%= link_to t("portfolio.resume.download", default: "Download"), resume_url, download: "Kyle-Teixeira-Trindade-Resume.pdf", class: "rounded-full bg-emerald-400 px-5 py-2.5 text-sm font-medium text-stone-950" %></div></div><div class="mt-10 overflow-hidden rounded-2xl border border-white/10 bg-stone-900"><object data="<%= resume_url %>#view=FitH" type="application/pdf" class="h-[70vh] min-h-[600px] w-full"><div class="flex min-h-72 items-center justify-center p-8 text-center"><p class="text-stone-400"><%= t("portfolio.resume.fallback", default: "Your browser cannot display this PDF.") %> <%= link_to t("portfolio.resume.open", default: "Open PDF ↗"), resume_url, target: "_blank", class: "text-emerald-400" %></p></div></object></div></div></section>
<section id="contact" class="mx-auto max-w-7xl px-6 py-28 text-center"><p class="section-label"><%= t("portfolio.contact.label", default: "07 / Contact") %></p><h2 class="mx-auto mt-10 max-w-4xl text-5xl font-semibold tracking-[-.04em] text-white sm:text-7xl"><%= t("portfolio.contact.title", default: "Let’s turn the next business process into reliable software.") %></h2><div class="mt-10 flex flex-wrap justify-center gap-3"><a href="mailto:<%= email %>" class="rounded-full bg-emerald-400 px-7 py-3 font-medium text-stone-950"><%= email %></a><a href="tel:<%= phone %>" class="pill-link">+55 31 98843-7435</a><a href="<%= linkedin_url %>" target="_blank" rel="noopener" class="pill-link">LinkedIn ↗</a><a href="<%= github_url %>" target="_blank" rel="noopener" class="pill-link">GitHub ↗</a></div></section></main>
<footer class="border-t border-white/10"><div class="mx-auto flex max-w-7xl flex-col justify-between gap-4 px-6 py-8 text-sm text-stone-500 sm:flex-row"><p>© <%= Time.current.year %> Kyle Teixeira Trindade</p><p><%= t("portfolio.footer", default: "Ruby on Rails · B2B Systems · SaaS") %></p></div></footer>
