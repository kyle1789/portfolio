<% if record.screenshots.attached? %><div class="grid w-full <%= 'sm:grid-cols-2' if record.screenshots.size > 1 %>"><% record.screenshots.each do |screenshot| %><%= link_to rails_blob_path(screenshot, disposition: "inline"), target: "_blank", rel: "noopener", class: "block bg-[#f4f4f2]" do %><%= image_tag screenshot.variant(resize_to_limit: [1600, 1100]), class: "h-auto w-full object-contain", alt: "#{record.try(:title) || record.try(:name)} screenshot", loading: "lazy" %><% end %><% end %></div><% end %>
