<!DOCTYPE html><html lang="en"><head><title>Portfolio Admin</title><meta name="viewport" content="width=device-width,initial-scale=1"><%= csrf_meta_tags %><%= csp_meta_tag %><%= stylesheet_link_tag :app, "data-turbo-track": "reload" %><%= javascript_importmap_tags %></head><body class="bg-stone-950 text-stone-200"><header class="border-b border-white/10"><nav class="mx-auto flex max-w-6xl items-center gap-6 px-6 py-4"><%= link_to "← Portfolio", root_path, class: "font-bold text-white" %><%= link_to "Experiences", admin_experiences_path, class: "text-sm text-stone-400 hover:text-white" %><%= link_to "Projects", admin_projects_path, class: "text-sm text-stone-400 hover:text-white" %></nav></header><main class="mx-auto max-w-6xl px-6 py-10"><% if notice %><p class="mb-6 rounded-lg border border-emerald-500/30 bg-emerald-500/10 p-3 text-emerald-300"><%= notice %></p><% end %><%= yield %></main></body></html>
