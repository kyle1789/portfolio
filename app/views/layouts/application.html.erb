<!DOCTYPE html>
<html lang="<%= I18n.locale == :'pt-BR' ? 'pt-BR' : 'en' %>" class="scroll-smooth">
  <head>
    <title><%= t("portfolio.seo.title", default: "Kyle Teixeira Trindade — Software Engineer") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <meta name="description" content="<%= t("portfolio.seo.description", default: "Ruby on Rails software engineer focused on B2B systems, SaaS, integrations and business process automation.") %>">
    <meta property="og:title" content="<%= t("portfolio.seo.title", default: "Kyle Teixeira Trindade — Software Engineer") %>">
    <meta property="og:description" content="<%= t("portfolio.seo.description", default: "Ruby on Rails software engineer focused on B2B systems, SaaS, integrations and business process automation.") %>">
    <meta property="og:type" content="website">

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-[#0b0d0e] text-stone-200 antialiased">
    <%= yield %>
  </body>
</html>
