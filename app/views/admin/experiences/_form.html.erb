<%= form_with model: [:admin, experience], class: "max-w-3xl space-y-5" do |form| %><%= render "admin/shared/errors", record: experience %><div class="grid gap-5 sm:grid-cols-2"><%= render "admin/shared/field", form: form, name: :title %><%= render "admin/shared/field", form: form, name: :company %></div><%= render "admin/shared/field", form: form, name: :subtitle %><%= render "admin/shared/textarea", form: form, name: :short_description %><%= render "admin/shared/textarea", form: form, name: :description, rows: 14 %><%= render "admin/shared/textarea", form: form, name: :technologies, rows: 3 %><div class="grid gap-5 sm:grid-cols-3"><%= render "admin/shared/field", form: form, name: :start_date, type: :date_field %><%= render "admin/shared/field", form: form, name: :end_date, type: :date_field %><%= render "admin/shared/field", form: form, name: :position, type: :number_field %></div><div class="flex gap-6"><label><%= form.check_box :current %> Current</label><label><%= form.check_box :featured %> Featured</label></div><%= render "admin/shared/uploads", form: form, record: experience %><%= form.submit class: "admin-button cursor-pointer" %><% end %>
