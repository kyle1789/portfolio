<div class="mt-8 divide-y divide-white/10 rounded-xl border border-white/10"><% records.each do |record| %><div class="flex items-center justify-between p-5"><div><p class="font-medium"><%= record.try(:title) || record.try(:name) %></p><p class="text-sm text-stone-500">Position <%= record.position %></p></div><div class="flex gap-4 text-sm"><%= link_to "View", [:admin, record] %><%= link_to "Edit", [:edit, :admin, record], class: "text-emerald-400" %><%= link_to "Delete", [:admin, record], data: { turbo_method: :delete, turbo_confirm: "Delete this item?" }, class: "text-red-400" %></div></div><% end %></div>
