<div><%= form.label :screenshots, "Add screenshots", class: "mb-2 block text-sm text-stone-400" %><%= form.file_field :screenshots, multiple: true, accept: "image/*", class: "admin-input" %></div><% if record.screenshots.attached? %><div class="grid grid-cols-2 gap-4 sm:grid-cols-3"><% record.screenshots.each do |image| %><div><%= image_tag image.variant(resize_to_limit: [400, 260]), class: "aspect-video rounded-lg object-cover" %><%= link_to "Remove", url_for(action: :remove_screenshot, id: record.id, attachment_id: image.id), data: { turbo_method: :delete, turbo_confirm: "Remove screenshot?" }, class: "mt-2 inline-block text-sm text-red-400" %></div><% end %></div><% end %>
