<%= form_with model: [:admin, project], class: "max-w-3xl space-y-5" do |form| %><%= render "admin/shared/errors", record: project %><%= render "admin/shared/field", form: form, name: :name %><%= render "admin/shared/textarea", form: form, name: :short_description %><%= render "admin/shared/textarea", form: form, name: :description, rows: 14 %><%= render "admin/shared/textarea", form: form, name: :technologies, rows: 3 %><div class="grid gap-5 sm:grid-cols-2"><%= render "admin/shared/field", form: form, name: :github_url %><%= render "admin/shared/field", form: form, name: :live_url %></div><%= render "admin/shared/field", form: form, name: :position, type: :number_field %><label><%= form.check_box :featured %> Featured</label><%= render "admin/shared/uploads", form: form, record: project %><%= form.submit class: "admin-button cursor-pointer" %><% end %>
